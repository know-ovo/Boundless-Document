{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "无界文档",
  "version": "0.1.0",
  "identifier": "com.boundless.docs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "无界文档",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src *; img-src * data: blob:; media-src *; font-src 'self'; worker-src 'self' blob:; frame-src *"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
